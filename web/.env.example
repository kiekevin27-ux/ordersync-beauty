# Salin file ini menjadi .env.local, lalu sesuaikan.

# Alamat webhook workflow n8n 03 (yang sudah di-Publish).
#   n8n lokal  : http://localhost:5678/webhook/glowra-order-sheets
#   mode tes   : http://localhost:5678/webhook-test/glowra-order-sheets  (harus klik "Listen for test event" dulu)
#   n8n Cloud  : https://namakamu.app.n8n.cloud/webhook/glowra-order-sheets
N8N_WEBHOOK_URL=http://localhost:5678/webhook/glowra-order-sheets

# Alamat webhook workflow n8n 04 (notifikasi marketplace), dipakai halaman /simulator.
N8N_MARKETPLACE_WEBHOOK_URL=http://localhost:5678/webhook/glowra-marketplace

# (Opsional) Link Google Sheet, supaya muncul tombol "Buka Google Sheets" setelah checkout.
NEXT_PUBLIC_SHEET_URL=
